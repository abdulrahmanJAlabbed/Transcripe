# ~/.config/systemd/user/ on the Pi, installed by `./deploy.sh pi`.
# The same studio API as alabed.site, with a Whisper model the server's two
# shared cores could never run. Reachable only on loopback; the tunnel unit
# carries it to the server, which sends transcriptions here while it answers.
[Unit]
Description=Transcripe: Whisper worker for alabed.site
After=network-online.target

[Service]
WorkingDirectory=%h/transcripe-worker
# TRANSCRIPE_TOKEN=<shared with the server's /etc/transcripe/remote.env>
EnvironmentFile=%h/.config/transcripe/worker.env
# Measured on this Pi 500 (FLEURS, 5 min per language, int8, 4 threads):
# Arabic 13.9% WER at 1.94x real time, Turkish 16.8% at 1.35x, 2 GB RSS.
# The server's `base` scored 47.7% on the same Arabic clip.
Environment=TRANSCRIPE_MODEL=large-v3-turbo
Environment=TRANSCRIPE_PARALLEL=1
# No browser ever talks to this one directly.
Environment=TRANSCRIPE_ORIGINS=
# Uploads and transcripts are tmpfs-only: the SD card failed once already.
Environment=TMPDIR=/tmp
ExecStart=%h/transcripe-worker/venv/bin/uvicorn transcripe.studio:app --host 127.0.0.1 --port 8110 --workers 1
# Other projects share this Pi; a long transcription should yield to them.
Nice=10
StandardOutput=append:/tmp/transcripe-worker.log
StandardError=append:/tmp/transcripe-worker.log
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
