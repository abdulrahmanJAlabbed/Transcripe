# The app talks to the hosted engine at https://alabed.site by default, and
# needs no configuration at all. This file is only for pointing it somewhere
# else — a studio you are running yourself, while developing.
#
#   transcripe studio --lan        # binds 0.0.0.0 so the phone can see it
#
# EXPO_PUBLIC_API_URL=http://192.168.0.105:8000
#
# A studio open to the network mints a token and prints it on startup.
# EXPO_PUBLIC_API_TOKEN=
